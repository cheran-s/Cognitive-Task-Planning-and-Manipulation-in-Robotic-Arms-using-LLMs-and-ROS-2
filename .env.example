# ========================================================
# Cognitive Robotic Manipulation Platform Environment Config
# ========================================================

# Application Mode
DEBUG=true
HOST=0.0.0.0
PORT=8000

# LLM Provider Configuration ("fallback", "gemini", "openai", "anthropic")
# Keep your API keys in this file - NEVER commit API keys to version control!
LLM_PROVIDER=fallback
GEMINI_API_KEY=
OPENAI_API_KEY=

# ROS 2 Integration
# Set to true when running ROS 2 Jazzy rosbridge on port 9090
ROS_BRIDGE_ENABLED=false
ROS_BRIDGE_URL=ws://localhost:9090
DEFAULT_SIMULATION_MODE=true
