<?xml version="1.0" encoding="UTF-8"?>
<robot name="detailed_arm">

  <!-- ========================================== -->
  <!--             PLANNING GROUPS                -->
  <!-- ========================================== -->
  <!-- Arm Planning Group: Kinematic Chain base_link -> wrist_3_link -->
  <group name="arm">
    <chain base_link="base_link" tip_link="wrist_3_link"/>
  </group>

  <!-- Gripper Planning Group -->
  <group name="gripper">
    <link name="gripper_base_link"/>
    <link name="left_finger_link"/>
    <link name="right_finger_link"/>
    <joint name="finger_joint"/>
  </group>

  <!-- Combined Arm + Gripper Group -->
  <group name="arm_with_gripper">
    <group name="arm"/>
    <group name="gripper"/>
  </group>

  <!-- ========================================== -->
  <!--             END EFFECTOR                   -->
  <!-- ========================================== -->
  <end_effector name="gripper_ee" parent_link="wrist_3_link" group="gripper" parent_group="arm"/>

  <!-- ========================================== -->
  <!--           GROUP TARGET STATES              -->
  <!-- ========================================== -->
  <!-- Arm: Home State (all zeros) -->
  <group_state name="home" group="arm">
    <joint name="joint1" value="0.0"/>
    <joint name="joint2" value="0.0"/>
    <joint name="joint3" value="0.0"/>
    <joint name="joint4" value="0.0"/>
    <joint name="joint5" value="0.0"/>
    <joint name="joint6" value="0.0"/>
  </group_state>

  <!-- Arm: Ready State (upright working standby) -->
  <group_state name="ready" group="arm">
    <joint name="joint1" value="0.0"/>
    <joint name="joint2" value="-0.6"/>
    <joint name="joint3" value="1.2"/>
    <joint name="joint4" value="0.0"/>
    <joint name="joint5" value="0.6"/>
    <joint name="joint6" value="0.0"/>
  </group_state>

  <!-- Arm: Pick Pose (forward reaching grasping pose) -->
  <group_state name="pick_pose" group="arm">
    <joint name="joint1" value="0.0"/>
    <joint name="joint2" value="0.5"/>
    <joint name="joint3" value="0.8"/>
    <joint name="joint4" value="0.0"/>
    <joint name="joint5" value="0.3"/>
    <joint name="joint6" value="0.0"/>
  </group_state>

  <!-- Arm: Bend Down (inspect lower area / pallet) -->
  <group_state name="bend_down" group="arm">
    <joint name="joint1" value="0.0"/>
    <joint name="joint2" value="1.1"/>
    <joint name="joint3" value="0.9"/>
    <joint name="joint4" value="0.0"/>
    <joint name="joint5" value="-0.4"/>
    <joint name="joint6" value="0.0"/>
  </group_state>

  <!-- Gripper: Open Hand -->
  <group_state name="open_hand" group="gripper">
    <joint name="finger_joint" value="0.04"/>
  </group_state>

  <!-- Gripper: Closed Hand -->
  <group_state name="closed_hand" group="gripper">
    <joint name="finger_joint" value="0.0"/>
  </group_state>

  <!-- ========================================== -->
  <!--           DISABLE COLLISIONS               -->
  <!-- ========================================== -->
  <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="upper_arm_link" reason="Never"/>
  
  <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="forearm_link" reason="Never"/>

  <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="upper_arm_link" link2="wrist_1_link" reason="Never"/>

  <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_3_link" reason="Never"/>

  <disable_collisions link1="wrist_3_link" link2="gripper_base_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_2_link" link2="gripper_base_link" reason="Never"/>

  <disable_collisions link1="gripper_base_link" link2="left_finger_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_base_link" link2="right_finger_link" reason="Adjacent"/>
  <disable_collisions link1="left_finger_link" link2="right_finger_link" reason="Never"/>
  <disable_collisions link1="wrist_3_link" link2="left_finger_link" reason="Never"/>
  <disable_collisions link1="wrist_3_link" link2="right_finger_link" reason="Never"/>

</robot>
