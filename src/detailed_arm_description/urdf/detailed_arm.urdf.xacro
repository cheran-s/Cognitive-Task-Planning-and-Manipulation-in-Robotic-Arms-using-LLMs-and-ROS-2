<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="detailed_arm">

  <!-- ========================================== -->
  <!--               PROPERTIES & MATERIALS       -->
  <!-- ========================================== -->
  <material name="metallic_silver">
    <color rgba="0.78 0.78 0.82 1.0"/>
  </material>

  <material name="matte_black">
    <color rgba="0.12 0.12 0.12 1.0"/>
  </material>

  <material name="accent_cyan">
    <color rgba="0.0 0.85 0.95 1.0"/>
  </material>

  <material name="dark_metal">
    <color rgba="0.25 0.25 0.28 1.0"/>
  </material>

  <material name="rubber_pad">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <!-- ========================================== -->
  <!--                 BASE LINK                  -->
  <!-- ========================================== -->
  <link name="base_link">
    <!-- Base mounting flange plate -->
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.04"/>
      </geometry>
      <material name="dark_metal"/>
    </visual>
    <!-- Chamfered lower ring -->
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.16" length="0.02"/>
      </geometry>
      <material name="metallic_silver"/>
    </visual>
    <!-- Base column pedestal -->
    <visual>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.13" length="0.08"/>
      </geometry>
      <material name="metallic_silver"/>
    </visual>
    <!-- Base decorative bolt heads (circular pattern) -->
    <visual>
      <origin xyz="0.14 0 0.042" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.008"/>
      </geometry>
      <material name="matte_black"/>
    </visual>
    <visual>
      <origin xyz="-0.14 0 0.042" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.008"/>
      </geometry>
      <material name="matte_black"/>
    </visual>
    <visual>
      <origin xyz="0 0.14 0.042" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.008"/>
      </geometry>
      <material name="matte_black"/>
    </visual>
    <visual>
      <origin xyz="0 -0.14 0.042" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.012" length="0.008"/>
      </geometry>
      <material name="matte_black"/>
    </visual>
    <!-- Cyan glow accent indicator ring -->
    <visual>
      <origin xyz="0 0 0.145" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.132" length="0.01"/>
      </geometry>
      <material name="accent_cyan"/>
    </visual>
    <!-- Base Top Bearing Mount -->
    <visual>
      <origin xyz="0 0 0.155" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.125" length="0.01"/>
      </geometry>
      <material name="matte_black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.18" length="0.16"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <mass value="9.5"/>
      <inertia ixx="0.085" ixy="0.0" ixz="0.0" iyy="0.085" iyz="0.0" izz="0.14"/>
    </inertial>
  </link>

  <!-- ========================================== -->
  <!--         JOINT 1: BASE YAW ROTATION         -->
  <!-- ========================================== -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.16" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="180.0" velocity="3.14"/>
    <dynamics damping="1.5" friction="1.0"/>
  </joint>

  <!-- ========================================== -->
  <!--              SHOULDER LINK                 -->
  <!-- ========================================== -->
  <link name="shoulder_link">
    <!-- Rotating turntable plate -->
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.12" length="0.04"/>
      </geometry>
      <material name="metallic_silver"/>
    </visual>
    <!-- Shoulder center turret block -->
    <visual>
      <origin xyz="0 0.01 0.08" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.16 0.12"/>
      </geometry>
      <material name="metallic_silver"/>
    </visual>
    <!-- Shoulder actuator matte black hub (Left side) -->
    <visual>
      <origin xyz="0 0.085 0.10" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.03"/>
      </geometry>
      <material name="matte_black"/>
    </visual>
    <!-- Actuator hub bolt rim (Left side) -->
    <visual>
      <origin xyz="0 0.102 0.10" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.005"/>
      </geometry>
      <material name="dark_metal"/>
    </visual>
    <!-- Shoulder actuator matte black hub (Right side) -->
    <visual>
      <origin xyz="0 -0.085 0.10" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.03"/>
      </geometry>
      <material name="matte_black"/>
    </visual>
    <visual>
      <origin xyz="0 -0.102 0.10" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.005"/>
      </geometry>
      <material name="dark_metal"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.22 0.16"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.07" rpy="0 0 0"/>
      <mass value="5.2"/>
      <inertia ixx="0.045" ixy="0.0" ixz="0.0" iyy="0.048" iyz="0.0" izz="0.052"/>
    </inertial>
  </link>

  <!-- ========================================== -->
  <!--        JOINT 2: SHOULDER PITCH ROTATION    -->
  <!-- ========================================== -->
  <joint name="joint2" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0.06 0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0944" upper="2.0944" effort="160.0" velocity="2.5"/>
    <dynamics damping="1.5" friction="1.0"/>
  </joint>

  <!-- ========================================== -->
  <!--              UPPER ARM LINK                -->
  <!-- ========================================== -->
  <link name="upper_arm_link">
    <!-- Joint pivot cylinder hub -->
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.075" length="0.10"/>
      </geometry>
      <material name="matte_black"/>
    </visual>
    <!-- Main twin-beam structural arm body -->
    <visual>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <geometry>
        <box size="0.11 0.09 0.36"/>
      </geometry>
      <material name="metallic_silver"/>
    </visual>
    <!-- Chamfered side reinforcement rib (Front) -->
    <visual>
      <origin xyz="0.058 0 0.20" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.07 0.32"/>
      </geometry>
      <material name="dark_metal"/>
    </visual>
    <!-- Chamfered side reinforcement rib (Back) -->
    <visual>
      <origin xyz="-0.058 0 0.20" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.07 0.32"/>
      </geometry>
      <material name="dark_metal"/>
    </visual>
    <!-- Decorative side conduit duct -->
    <visual>
      <origin xyz="0 -0.048 0.20" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.015 0.30"/>
      </geometry>
      <material name="matte_black"/>
    </visual>
    <!-- Cyan industrial stripe -->
    <visual>
      <origin xyz="0 0.048 0.20" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.005 0.28"/>
      </geometry>
      <material name="accent_cyan"/>
    </visual>
    <!-- Upper elbow actuator housing -->
    <visual>
      <origin xyz="0 0 0.40" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.07" length="0.10"/>
      </geometry>
      <material name="matte_black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <geometry>
        <box size="0.13 0.12 0.44"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <mass value="4.8"/>
      <inertia ixx="0.072" ixy="0.0" ixz="0.0" iyy="0.072" iyz="0.0" izz="0.018"/>
    </inertial>
  </link>

  <!-- ========================================== -->
  <!--         JOINT 3: ELBOW PITCH ROTATION      -->
  <!-- ========================================== -->
  <joint name="joint3" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 -0.06 0.40" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.6179" upper="2.6179" effort="120.0" velocity="2.5"/>
    <dynamics damping="1.2" friction="0.8"/>
  </joint>

  <!-- ========================================== -->
  <!--               FOREARM LINK                 -->
  <!-- ========================================== -->
  <link name="forearm_link">
    <!-- Elbow pivot cylinder hub -->
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.09"/>
      </geometry>
      <material name="matte_black"/>
    </visual>
    <!-- Forearm main structural column -->
    <visual>
      <origin xyz="0 0 0.175" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.30"/>
      </geometry>
      <material name="metallic_silver"/>
    </visual>
    <!-- Forearm structural side casings -->
    <visual>
      <origin xyz="0 0 0.175" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.08 0.26"/>
      </geometry>
      <material name="metallic_silver"/>
    </visual>
    <!-- Forearm rotary actuator motor pack -->
    <visual>
      <origin xyz="0 0.048 0.14" rpy="0 0 0"/>
      <geometry>
        <box size="0.07 0.03 0.16"/>
      </geometry>
      <material name="matte_black"/>
    </visual>
    <!-- Forearm accent indicator ring -->
    <visual>
      <origin xyz="0 0 0.32" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.052" length="0.008"/>
      </geometry>
      <material name="accent_cyan"/>
    </visual>
    <!-- Forearm top flange -->
    <visual>
      <origin xyz="0 0 0.345" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.01"/>
      </geometry>
      <material name="matte_black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.175" rpy="0 0 0"/>
      <geometry>
        <box size="0.11 0.10 0.37"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.175" rpy="0 0 0"/>
      <mass value="3.4"/>
      <inertia ixx="0.042" ixy="0.0" ixz="0.0" iyy="0.042" iyz="0.0" izz="0.009"/>
    </inertial>
  </link>

  <!-- ========================================== -->
  <!--         JOINT 4: FOREARM / WRIST 1 ROLL    -->
  <!-- ========================================== -->
  <joint name="joint4" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin xyz="0 0 0.35" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="60.0" velocity="3.14"/>
    <dynamics damping="0.8" friction="0.5"/>
  </joint>

  <!-- ========================================== -->
  <!--               WRIST 1 LINK                 -->
  <!-- ========================================== -->
  <link name="wrist_1_link">
    <!-- Bottom rotating plate -->
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.052" length="0.03"/>
      </geometry>
      <material name="matte_black"/>
    </visual>
    <!-- Wrist 1 pivot block -->
    <visual>
      <origin xyz="0 0.01 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.07 0.06"/>
      </geometry>
      <material name="metallic_silver"/>
    </visual>
    <!-- Lateral wrist pitch motor caps -->
    <visual>
      <origin xyz="0 0.045 0.055" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.036" length="0.02"/>
      </geometry>
      <material name="matte_black"/>
    </visual>
    <visual>
      <origin xyz="0 -0.045 0.055" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.036" length="0.02"/>
      </geometry>
      <material name="matte_black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.11 0.09"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.045" rpy="0 0 0"/>
      <mass value="1.6"/>
      <inertia ixx="0.007" ixy="0.0" ixz="0.0" iyy="0.007" iyz="0.0" izz="0.005"/>
    </inertial>
  </link>

  <!-- ========================================== -->
  <!--        JOINT 5: WRIST 2 PITCH ROTATION     -->
  <!-- ========================================== -->
  <joint name="joint5" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin xyz="0 0.03 0.055" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0944" upper="2.0944" effort="40.0" velocity="3.14"/>
    <dynamics damping="0.5" friction="0.3"/>
  </joint>

  <!-- ========================================== -->
  <!--               WRIST 2 LINK                 -->
  <!-- ========================================== -->
  <link name="wrist_2_link">
    <!-- Pitch pivot cylinder hub -->
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.06"/>
      </geometry>
      <material name="matte_black"/>
    </visual>
    <!-- Wrist 2 structural link body -->
    <visual>
      <origin xyz="0 -0.015 0.035" rpy="0 0 0"/>
      <geometry>
        <box size="0.065 0.055 0.05"/>
      </geometry>
      <material name="metallic_silver"/>
    </visual>
    <!-- Tool roll motor collar -->
    <visual>
      <origin xyz="0 -0.03 0.055" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.034" length="0.02"/>
      </geometry>
      <material name="matte_black"/>
    </visual>

    <collision>
      <origin xyz="0 -0.015 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.075 0.07 0.07"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 -0.015 0.03" rpy="0 0 0"/>
      <mass value="1.1"/>
      <inertia ixx="0.003" ixy="0.0" ixz="0.0" iyy="0.003" iyz="0.0" izz="0.002"/>
    </inertial>
  </link>

  <!-- ========================================== -->
  <!--         JOINT 6: WRIST 3 ROLL ROTATION     -->
  <!-- ========================================== -->
  <joint name="joint6" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <origin xyz="0 -0.03 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="25.0" velocity="3.14"/>
    <dynamics damping="0.3" friction="0.2"/>
  </joint>

  <!-- ========================================== -->
  <!--               WRIST 3 LINK                 -->
  <!-- ========================================== -->
  <link name="wrist_3_link">
    <!-- Rotating tool flange plate -->
    <visual>
      <origin xyz="0 0 0.008" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.016"/>
      </geometry>
      <material name="metallic_silver"/>
    </visual>
    <!-- Flange center locating boss -->
    <visual>
      <origin xyz="0 0 0.018" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.006"/>
      </geometry>
      <material name="dark_metal"/>
    </visual>
    <!-- Flange mounting bolt pattern (4 bolts) -->
    <visual>
      <origin xyz="0.025 0 0.017" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.004" length="0.004"/>
      </geometry>
      <material name="matte_black"/>
    </visual>
    <visual>
      <origin xyz="-0.025 0 0.017" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.004" length="0.004"/>
      </geometry>
      <material name="matte_black"/>
    </visual>
    <visual>
      <origin xyz="0 0.025 0.017" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.004" length="0.004"/>
      </geometry>
      <material name="matte_black"/>
    </visual>
    <visual>
      <origin xyz="0 -0.025 0.017" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.004" length="0.004"/>
      </geometry>
      <material name="matte_black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.02"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <mass value="0.45"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <!-- ========================================== -->
  <!--        FIXED GRIPPER MOUNT JOINT           -->
  <!-- ========================================== -->
  <joint name="gripper_mount_joint" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="gripper_base_link"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>

  <!-- ========================================== -->
  <!--           GRIPPER BASE LINK                -->
  <!-- ========================================== -->
  <link name="gripper_base_link">
    <!-- Main gripper actuator body -->
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.07 0.08 0.04"/>
      </geometry>
      <material name="matte_black"/>
    </visual>
    <!-- Gripper faceplate in metallic silver -->
    <visual>
      <origin xyz="0 0 0.042" rpy="0 0 0"/>
      <geometry>
        <box size="0.065 0.075 0.005"/>
      </geometry>
      <material name="metallic_silver"/>
    </visual>
    <!-- Left guide rail channel -->
    <visual>
      <origin xyz="0 0.025 0.046" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.015 0.006"/>
      </geometry>
      <material name="dark_metal"/>
    </visual>
    <!-- Right guide rail channel -->
    <visual>
      <origin xyz="0 -0.025 0.046" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.015 0.006"/>
      </geometry>
      <material name="dark_metal"/>
    </visual>
    <!-- Status LED dot -->
    <visual>
      <origin xyz="0.028 0 0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.004" length="0.01"/>
      </geometry>
      <material name="accent_cyan"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.075 0.085 0.05"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.55"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <!-- ========================================== -->
  <!--   FINGER JOINT (ACTIVE: LEFT FINGER)       -->
  <!-- ========================================== -->
  <joint name="finger_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="left_finger_link"/>
    <origin xyz="0 0.01 0.045" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.04" effort="30.0" velocity="0.1"/>
    <dynamics damping="0.2" friction="0.1"/>
  </joint>

  <!-- ========================================== -->
  <!--              LEFT FINGER LINK              -->
  <!-- ========================================== -->
  <link name="left_finger_link">
    <!-- Finger slider carrier -->
    <visual>
      <origin xyz="0 0.005 0.012" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.015 0.025"/>
      </geometry>
      <material name="metallic_silver"/>
    </visual>
    <!-- Finger claw arm -->
    <visual>
      <origin xyz="0 0.008 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.01 0.04"/>
      </geometry>
      <material name="dark_metal"/>
    </visual>
    <!-- Soft rubber grip friction pad -->
    <visual>
      <origin xyz="0 0.002 0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.018 0.003 0.03"/>
      </geometry>
      <material name="rubber_pad"/>
    </visual>
    <!-- Chamfered claw tip -->
    <visual>
      <origin xyz="0 0.005 0.062" rpy="0 0 0"/>
      <geometry>
        <box size="0.018 0.007 0.012"/>
      </geometry>
      <material name="metallic_silver"/>
    </visual>

    <collision>
      <origin xyz="0 0.006 0.038" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.018 0.065"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0.006 0.035" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.00005"/>
    </inertial>
  </link>

  <!-- ========================================== -->
  <!--   FINGER JOINT MIMIC (PASSIVE: RIGHT FINGER)-->
  <!-- ========================================== -->
  <joint name="finger_joint_mimic" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="right_finger_link"/>
    <origin xyz="0 -0.01 0.045" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.04" effort="30.0" velocity="0.1"/>
    <mimic joint="finger_joint" multiplier="1.0" offset="0.0"/>
    <dynamics damping="0.2" friction="0.1"/>
  </joint>

  <!-- ========================================== -->
  <!--              RIGHT FINGER LINK             -->
  <!-- ========================================== -->
  <link name="right_finger_link">
    <!-- Finger slider carrier -->
    <visual>
      <origin xyz="0 -0.005 0.012" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.015 0.025"/>
      </geometry>
      <material name="metallic_silver"/>
    </visual>
    <!-- Finger claw arm -->
    <visual>
      <origin xyz="0 -0.008 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.01 0.04"/>
      </geometry>
      <material name="dark_metal"/>
    </visual>
    <!-- Soft rubber grip friction pad -->
    <visual>
      <origin xyz="0 -0.002 0.045" rpy="0 0 0"/>
      <geometry>
        <box size="0.018 0.003 0.03"/>
      </geometry>
      <material name="rubber_pad"/>
    </visual>
    <!-- Chamfered claw tip -->
    <visual>
      <origin xyz="0 -0.005 0.062" rpy="0 0 0"/>
      <geometry>
        <box size="0.018 0.007 0.012"/>
      </geometry>
      <material name="metallic_silver"/>
    </visual>

    <collision>
      <origin xyz="0 -0.006 0.038" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.018 0.065"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 -0.006 0.035" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.00005"/>
    </inertial>
  </link>

  <!-- Tool Center Point (TCP) virtual frame for end-effector planning -->
  <link name="tcp_link"/>
  <joint name="tcp_joint" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="tcp_link"/>
    <origin xyz="0 0 0.09" rpy="0 0 0"/>
  </joint>

</robot>
